{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "files_changed", "commands_run", "verification", "open_issues", "decision_requests"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "partial", "blocked", "failed"],
      "description": "completed=交付内容已完成，分配给你的验证也已做完；partial=部分完成；blocked=有 decision_requests 里的问题需要调度方决定，无法继续；failed=没做成"
    },
    "summary": { "type": "string", "description": "做了什么、关键实现决策，简明扼要" },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change"],
        "properties": {
          "path": { "type": "string" },
          "change": { "type": "string", "description": "这个文件改了什么" }
        }
      }
    },
    "commands_run": {
      "type": "array",
      "description": "运行过的构建、测试、脚本命令及结果",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "outcome"],
        "properties": {
          "command": { "type": "string" },
          "outcome": { "type": "string", "description": "通过/失败及关键输出" }
        }
      }
    },
    "verification": { "type": "string", "description": "如何验证结果正确；没验证就写没验证及原因" },
    "decision_requests": {
      "type": "array",
      "description": "需要调度方决定才能继续的问题；没有就为空数组",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "why_it_matters", "options", "recommendation"],
        "properties": {
          "question": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "recommendation": { "type": "string" }
        }
      }
    },
    "open_issues": {
      "type": "array",
      "items": { "type": "string" },
      "description": "未完成、未验证、有疑问或需要调度方决定的事项"
    }
  }
}
